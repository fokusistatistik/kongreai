# Database Configuration
DATABASE_URL="file:./prisma/dev.db"

# NextAuth Configuration
NEXTAUTH_URL="https://test.fokusistatistik.com"
# CRITICAL: Generate a strong secret with: openssl rand -base64 32
# Minimum 32 characters required!
NEXTAUTH_SECRET="your-secret-here-must-be-at-least-32-characters-long"

# Application URL
NEXT_PUBLIC_APP_URL="https://test.fokusistatistik.com"

# n8n Webhook Configuration
N8N_WEBHOOK_URL="https://n8n.fokusistatistik.com"

# Webhook API Key (Optional but recommended for production)
# Generate with: openssl rand -hex 32
# Configure n8n workflows to validate this key in 'X-Webhook-API-Key' header
WEBHOOK_API_KEY="your-webhook-api-key-here"
