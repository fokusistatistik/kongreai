// Congress Management System - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. USER TABLE (Kullanıcılar)
// ============================================
model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // bcrypt hash

  // KİŞİSEL BİLGİLER
  ad      String
  soyad   String
  unvan   String? // Prof. Dr., Doç. Dr., Uzm., vb.
  kurum   String? // Çalıştığı kurum
  telefon String?

  // ROL SİSTEMİ
  role String @default("KATILIMCI") // ADMIN, HAKEM, KATILIMCI

  // HESAP DURUMU
  aktif            Boolean   @default(true)
  email_verified   Boolean   @default(false)
  ilk_giris        Boolean   @default(true)
  son_giris_tarihi DateTime?

  // İLİŞKİLER
  applications Application[] // Kullanıcının yaptığı başvurular
  reviews      Review[] // Hakem ise yaptığı değerlendirmeler

  // ZAMAN DAMGALARI
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================
// 2. EVENT TABLE (Kongre/Etkinlik)
// ============================================
model Event {
  id   String @id @default(uuid())
  slug String @unique // URL-friendly identifier

  // TEMEL BİLGİLER
  baslik   String
  alt_baslik String? // Opsiyonel alt başlık
  tip      String  @default("KONGRE") // KONGRE, SEMPOZYUM, PANEL, CALISTAY
  aciklama String? // Rich text (HTML veya Markdown)

  // TARİHLER
  baslangic_tarihi    DateTime
  bitis_tarihi        DateTime
  son_basvuru_tarihi  DateTime
  erken_kayit_tarihi  DateTime? // Erken kayıt için son tarih

  // MEKAN
  yer           String // Örn: "İstanbul Kongre Merkezi"
  adres         String? // Detaylı adres
  online        Boolean @default(false) // Online/Hybrid mi?
  online_link   String? // Zoom, Teams linki

  // FİYATLANDIRMA
  ucret             Float   @default(0) // Katılım ücreti (TL)
  erken_kayit_ucret Float?  // Erken kayıt ücreti
  ogrenci_ucret     Float?  // Öğrenci ücreti
  ucretsiz          Boolean @default(false)

  // GÖRSEL VE MEDYA
  gorsel_url String? // Ana banner/poster
  logo_url   String? // Etkinlik logosu

  // İÇERİK ALANLARI (Rich Content)
  amaclar_hedefler String? // Amaçlar ve hedefler
  hedef_kitle      String? // Hedef katılımcı profili
  bilimsel_program String? // Program detayları
  kurullar         String? // Düzenleme, bilim, danışma kurulları (JSON)
  sponsor_bilgileri String? // Sponsorlar (JSON)

  // DURUM
  durum String @default("TASLAK") // TASLAK, YAYINDA, TAMAMLANDI, IPTAL

  // AYARLAR
  basvuru_aktif       Boolean @default(true)
  max_katilimci       Int?    // Katılımcı limiti
  sertifika_aktif     Boolean @default(true)
  katilim_sertifikasi String? // Sertifika şablonu URL

  // İLİŞKİLER
  applications Application[]

  // ZAMAN DAMGALARI
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by_id String? // Admin ID

  @@index([slug])
  @@index([durum])
  @@index([baslangic_tarihi])
  @@index([son_basvuru_tarihi])
  @@map("events")
}

// ============================================
// 3. APPLICATION TABLE (Başvuru/Bildiri)
// ============================================
model Application {
  id String @id @default(uuid())

  // İLİŞKİLER
  user_id  String
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event_id String
  event    Event  @relation(fields: [event_id], references: [id], onDelete: Cascade)

  // BAŞVURU TİPİ
  tip String // SOZLU_BILDIRI, POSTER, DINLEYICI

  // BİLDİRİ BİLGİLERİ (Eğer tip Dinleyici değilse)
  baslik       String? // Bildiri başlığı
  ozet         String? // Abstract (max 300 kelime)
  anahtar_kelimeler String? // Virgülle ayrılmış
  kategori     String? // Alan/kategori

  // YAZARLAR (JSON Array)
  yazarlar     String? // [{"ad": "X", "soyad": "Y", "kurum": "Z", "email": "e"}]

  // DOSYALAR
  dosya_url       String? // PDF bildiri
  ek_dosya_url    String? // Ek dosya (grafik, vb.)
  poster_url      String? // Poster sunumu için

  // SUNUM TERCİHİ
  sunum_tercihi String? // SOZLU, POSTER (kullanıcı tercihi)

  // DURUM YÖNETİMİ
  durum             String   @default("BEKLEMEDE") // BEKLEMEDE, HAKEMDE, KABUL, RED, REVIZYON
  hakem_notu        String? // Hakemin değerlendirme notu
  revizyon_talep    String? // Revizyon talepleri
  yonetici_notu     String? // Admin notu

  // SUNUM BİLGİLERİ (Kabul edildikten sonra)
  sunum_tarihi String? // Atanan sunum günü/saati
  sunum_salonu String? // Salon bilgisi
  oturum       String? // Hangi oturum

  // İLİŞKİLER
  payment Payment? // Ödeme bilgisi
  reviews Review[] // Hakem değerlendirmeleri

  // ZAMAN DAMGALARI
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  karar_tarihi  DateTime? // Kabul/Red tarihi

  @@unique([user_id, event_id]) // Bir kullanıcı bir etkinliğe sadece 1 başvuru yapabilir
  @@index([event_id])
  @@index([user_id])
  @@index([durum])
  @@map("applications")
}

// ============================================
// 4. PAYMENT TABLE (Ödeme)
// ============================================
model Payment {
  id String @id @default(uuid())

  // İLİŞKİLER
  application_id String      @unique
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  // ÖDEME BİLGİLERİ
  tutar        Float // TL
  odeme_tipi   String @default("IYZICO") // IYZICO, HAVALE, NAKIT, UCRETSIZ

  // IYZICO BİLGİLERİ
  islem_kodu   String? // Transaction/Payment ID
  iyzico_token String? // Iyzico conversation ID

  // HAVALE BİLGİLERİ
  havale_dekont_url String? // Dekont yükleme

  // DURUM
  durum            String   @default("BEKLIYOR") // BEKLIYOR, ODENDI, IPTAL, RED
  odeme_tarihi     DateTime?
  onaylayan_admin  String? // Admin ID
  onay_tarihi      DateTime?

  // NOTLAR
  aciklama String?

  // ZAMAN DAMGALARI
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([durum])
  @@map("payments")
}

// ============================================
// 5. REVIEW TABLE (Hakem Değerlendirme)
// ============================================
model Review {
  id String @id @default(uuid())

  // İLİŞKİLER
  application_id String
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  hakem_id       String
  hakem          User        @relation(fields: [hakem_id], references: [id], onDelete: Cascade)

  // DEĞERLENDİRME
  puan         Int? // 1-5 veya 1-10 arası
  karar        String? // KABUL, RED, REVIZYON
  yorum        String? // Hakem yorumu
  gizli_yorum  String? // Sadece admin görebilir

  // DURUM
  tamamlandi      Boolean   @default(false)
  tamamlanma_tarihi DateTime?

  // ZAMAN DAMGALARI
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([application_id, hakem_id])
  @@index([hakem_id])
  @@map("reviews")
}

// ============================================
// 6. PASSWORD RESET TOKEN
// ============================================
model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  email      String
  token      String   @unique @default(uuid())
  expires_at DateTime
  kullanildi Boolean  @default(false)
  ip_adresi  String?
  created_at DateTime @default(now())

  @@index([token])
  @@index([user_id])
  @@map("password_reset_tokens")
}

// ============================================
// 7. ACTIVITY LOG (Audit Trail)
// ============================================
model ActivityLog {
  id String @id @default(uuid())

  // KULLANICI BİLGİSİ
  user_id    String?
  user_email String?

  // İŞLEM BİLGİSİ
  islem      String // event.create, application.approve, vb.
  tablo      String // events, applications, users
  kayit_id   String? // İşlem yapılan kaydın ID'si
  aciklama   String?
  ip_adresi  String?

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([islem])
  @@index([created_at])
  @@map("activity_logs")
}
